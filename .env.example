# Copia este archivo como .env.local para desarrollo. Nunca subas contraseñas al repositorio.
# En Vercel, estas variables se capturan en el panel del proyecto, por entorno.

# desarrollo | pruebas | produccion
APP_ENV=desarrollo

# Base de datos. En Vercel se captura en el panel (solo el entorno Production del proyecto de pruebas).
# Ejemplo para el PostgreSQL local de scripts/db-local.sh:
# DATABASE_URL=postgres://postgres@127.0.0.1:5433/fitnessland_dev

# Solo para las pruebas automáticas de base de datos (crean y borran una base temporal):
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
